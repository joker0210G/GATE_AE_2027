# =====================================================================
# Obsidian Vault .gitignore
# Designed for GATE AE 2027 Shared Second Brain Vault
# =====================================================================

# ---------------------------------------------------------------------
# 🔒 PRIVATE / PERSONAL NOTES (DO NOT COMMIT TO GITHUB)
# ---------------------------------------------------------------------
journals/
Private/
Personal/
*.private.md

# ---------------------------------------------------------------------
# 🔑 OBSIDIAN LOCAL REST API & SENSITIVE KEYS (DO NOT COMMIT)
# ---------------------------------------------------------------------
.obsidian/plugins/*/data.json
.obsidian/plugins/obsidian-local-rest-api/
.obsidian/plugins/llm-hub/data.json

# ---------------------------------------------------------------------
# Obsidian Workspace & Local State (DO NOT COMMIT)
# ---------------------------------------------------------------------
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspace.json.bak
.obsidian/indexeddb/
.obsidian/cache/
.obsidian/backups/
.obsidian/local-settings.json
.obsidian/graph.json

# ---------------------------------------------------------------------
# OS Clutter & Local Temp Files
# ---------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------
# AI Agents & IDE Local Scratch Directories
# ---------------------------------------------------------------------
.brain/
scratch/
*.tmp
*.log
.gemini/antigravity-ide/
.antigravity/

# ---------------------------------------------------------------------
# Node / Build Artifacts & Vault Backups / Releases
# ---------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
__pycache__/
*.pyc
.env
.env.local

# Vault Update Backups & Release Zip Archives
.backup/
GATE_AE_2027_*.zip
scripts/*.log

